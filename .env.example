# Local server credentials. Keep actual values in .env.local.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional dedicated secret for hashing comment rate-limit identifiers.
# COMMENT_RATE_LIMIT_SECRET=

# Vercel needs FIREBASE_SERVICE_ACCOUNT_JSON instead of a local file path.
# FIREBASE_SERVICE_ACCOUNT_JSON=
