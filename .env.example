# Public Firebase browser configuration (Vite includes these in the browser build).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Private server credentials. Keep actual values in .env.local, never in VITE_ variables.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Server-only SMTP credentials. Port 465 uses secure=true; port 587 uses secure=false + STARTTLS.
SMTP_HOST=premium130-4.web-hosting.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Optional dedicated secret; defaults to CLOUDINARY_API_SECRET.
# MAIL_RATE_LIMIT_SECRET=
# Optional dedicated secret for hashing comment rate-limit identifiers.
# COMMENT_RATE_LIMIT_SECRET=

# Vercel needs FIREBASE_SERVICE_ACCOUNT_JSON instead of a local file path.
# FIREBASE_SERVICE_ACCOUNT_JSON=
