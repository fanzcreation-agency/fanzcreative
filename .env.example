# Public Firebase browser configuration (Vite includes these in the browser build).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Private server credentials. Keep actual values in .env.local, never in VITE_ variables.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-service-account.json
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional dedicated secret for hashing comment rate-limit identifiers.
# COMMENT_RATE_LIMIT_SECRET=

# Vercel needs FIREBASE_SERVICE_ACCOUNT_JSON instead of a local file path.
# FIREBASE_SERVICE_ACCOUNT_JSON=
