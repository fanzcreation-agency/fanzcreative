rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin reads and writes use the server API, which checks current account access.
    // Do not allow old browser tokens to bypass a disabled or removed admin role.
    match /posts/{slug} {
      allow read: if resource.data.status == 'published';
      allow create, update, delete: if false;
    }

    match /projects/{slug} {
      allow read: if resource.data.status == 'published';
      allow create, update, delete: if false;
    }

    // Comments (including emails) and abuse-protection data are server-API only.
    match /comments/{id} { allow read, write: if false; }
    match /commentRateLimits/{id} { allow read, write: if false; }
    match /commentDuplicates/{id} { allow read, write: if false; }
    match /_adminOperations/{id} { allow read, write: if false; }
    match /mailDeliveries/{id} { allow read, write: if false; }
    match /mailRateLimits/{id} { allow read, write: if false; }
  }
}
